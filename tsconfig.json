{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"moduleResolution": "Node",
		"target": "ES2018",
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"lib": [
			"DOM",
			"ES2018"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts",
		"tests/**/*.ts"
	]
}
